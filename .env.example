# ---- 部署配置（复制为 .env 或直接由环境变量注入） ----

# compose 项目名（本任务由环境固定，勿改）
COMPOSE_PROJECT_NAME=task2026-09-1115

# 宿主发布端口（仅应用服务发布到宿主）
CC_PUBLISH_PORT=3015

# MySQL（仅在 compose 内部网络使用，不发布到宿主）
MYSQL_DATABASE=rehab_platform
MYSQL_USER=rehab
MYSQL_PASSWORD=rehab123
MYSQL_ROOT_PASSWORD=root123456

# JWT 签名密钥（生产环境务必更换为足够长的随机串）
JWT_SECRET=rehab-platform-jwt-secret-key-0123456789abcdef-please-change-in-production
